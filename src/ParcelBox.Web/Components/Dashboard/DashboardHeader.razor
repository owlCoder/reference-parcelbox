<header class="app-header">
    <div class="brand-block">
        <h1>ParcelBox</h1>
    </div>

    <div class="header-actions">
        <div class="service-strip">
            <div class="service-status @GetServiceClass(ApiOnline)">
                <span class="status-dot"></span>
                <span>API</span>
            </div>
            <div class="service-status @GetServiceClass(LockerOnline)">
                <span class="status-dot"></span>
                <span>Locker</span>
            </div>
            <div class="service-status @GetServiceClass(MessageOnline)">
                <span class="status-dot"></span>
                <span>Message</span>
            </div>
        </div>

        <button class="button quiet" type="button" @onclick="RefreshRequested" disabled="@Busy">
            Refresh
        </button>
    </div>
</header>

@code {
    [Parameter]
    public bool ApiOnline { get; set; }

    [Parameter]
    public bool LockerOnline { get; set; }

    [Parameter]
    public bool MessageOnline { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback RefreshRequested { get; set; }

    private static string GetServiceClass(bool online)
    {
        return online ? "online" : "offline";
    }
}
