@page "/"
@inject ParcelBoxApiClient Api
@inject LockerSimulatorClient LockerSimulator
@inject MessageGatewayClient MessageGateway

<PageTitle>ParcelBox Demo</PageTitle>

<div class="page-shell">
    <header class="app-header">
        <div class="brand-block">
            <div class="brand-mark">PB</div>
            <div>
                <p class="eyebrow">ERS REFERENCE DEMO</p>
                <h1>ParcelBox</h1>
                <p class="subtitle">Clean Architecture through one small, visible end-to-end flow.</p>
            </div>
        </div>

        <div class="header-actions">
            <div class="service-strip">
                <div class="service-status @GetServiceClass(_apiOnline)">
                    <span class="status-dot"></span>
                    <span>API</span>
                </div>
                <div class="service-status @GetServiceClass(_lockerOnline)">
                    <span class="status-dot"></span>
                    <span>Locker</span>
                </div>
                <div class="service-status @GetServiceClass(_messageOnline)">
                    <span class="status-dot"></span>
                    <span>Message</span>
                </div>
            </div>

            <button class="button quiet" type="button" @onclick="RefreshAllAsync" disabled="@_busy">
                <span class="button-icon">↻</span>
                Refresh
            </button>
        </div>
    </header>

    <main>
        <section class="hero-card">
            <div>
                <p class="section-kicker">END-TO-END FLOW</p>
                <h2>One parcel. Three use-cases. Two external simulators.</h2>
                <p>
                    Follow the state transition from registration to storage and pickup, then break the external systems on purpose.
                </p>
            </div>

            <div class="flow-strip">
                <div class="flow-node active">
                    <span>01</span>
                    <strong>Register</strong>
                </div>
                <div class="flow-line"></div>
                <div class="flow-node @(_currentParcel?.Status is ParcelStatus.Stored or ParcelStatus.PickedUp ? "active" : string.Empty)">
                    <span>02</span>
                    <strong>Store</strong>
                </div>
                <div class="flow-line"></div>
                <div class="flow-node @(_currentParcel?.Status == ParcelStatus.PickedUp ? "active" : string.Empty)">
                    <span>03</span>
                    <strong>Pickup</strong>
                </div>
            </div>
        </section>

        <section class="workspace-grid">
            <div class="workflow-column">
                <article class="surface action-card">
                    <div class="card-title-row">
                        <div class="step-badge">01</div>
                        <div>
                            <p class="section-kicker">PARCELS</p>
                            <h2>Register parcel</h2>
                            <p>Create the aggregate that starts the demo flow.</p>
                        </div>
                    </div>

                    <div class="form-grid">
                        <label>
                            <span>Tracking code</span>
                            <input @bind="_trackingCode" placeholder="PKG-001" autocomplete="off" />
                        </label>

                        <label>
                            <span>Recipient phone</span>
                            <input @bind="_recipientPhone" placeholder="+38160111222" autocomplete="off" />
                        </label>

                        <label class="full-width">
                            <span>Parcel size</span>
                            <select @bind="_size">
                                @foreach (var size in Enum.GetValues<SizeCategory>())
                                {
                                    <option value="@size">@size</option>
                                }
                            </select>
                        </label>
                    </div>

                    <button class="button primary full-button" type="button" @onclick="RegisterAsync" disabled="@_busy">
                        Register parcel
                        <span>→</span>
                    </button>

                    @if (_currentParcel is not null)
                    {
                        <div class="parcel-summary">
                            <div class="summary-heading">
                                <div>
                                    <span class="summary-label">CURRENT PARCEL</span>
                                    <strong>@_currentParcel.TrackingCode</strong>
                                </div>
                                <span class="status-badge @GetParcelStatusClass(_currentParcel.Status)">@_currentParcel.Status</span>
                            </div>

                            <div class="summary-grid">
                                <div>
                                    <span>Size</span>
                                    <strong>@_currentParcel.Size</strong>
                                </div>
                                <div>
                                    <span>Recipient</span>
                                    <strong>@_currentParcel.RecipientPhone</strong>
                                </div>
                                <div>
                                    <span>Locker</span>
                                    <strong>@(_currentParcel.LockerCode ?? "—")</strong>
                                </div>
                                <div>
                                    <span>Compartment</span>
                                    <strong>@(_currentParcel.CompartmentNumber ?? "—")</strong>
                                </div>
                            </div>

                            @if (_currentParcel.Status == ParcelStatus.Registered)
                            {
                                <button class="button accent full-button" type="button" @onclick="StoreAsync" disabled="@_busy">
                                    Store in available compartment
                                    <span>→</span>
                                </button>
                            }
                        </div>
                    }
                </article>

                <article class="surface action-card">
                    <div class="card-title-row">
                        <div class="step-badge">03</div>
                        <div>
                            <p class="section-kicker">PICKUP</p>
                            <h2>Open &amp; pickup</h2>
                            <p>The domain transition finishes only after the locker controller succeeds.</p>
                        </div>
                    </div>

                    <div class="form-grid">
                        <label>
                            <span>Tracking code</span>
                            <input @bind="_pickupTrackingCode" placeholder="PKG-001" autocomplete="off" />
                        </label>

                        <label>
                            <span>Pickup code</span>
                            <input @bind="_pickupCode" placeholder="6 digit code" inputmode="numeric" autocomplete="one-time-code" />
                        </label>
                    </div>

                    <button class="button primary full-button" type="button" @onclick="PickupAsync" disabled="@_busy">
                        Open locker &amp; complete pickup
                        <span>→</span>
                    </button>

                    @if (_currentParcel?.Status == ParcelStatus.PickedUp)
                    {
                        <div class="notice success-notice">
                            <span class="notice-icon">✓</span>
                            <div>
                                <strong>Pickup completed</strong>
                                <p>@_currentParcel.TrackingCode reached the final domain state.</p>
                            </div>
                        </div>
                    }
                </article>
            </div>

            <div class="visual-column">
                <article class="surface locker-surface">
                    <div class="section-heading-row">
                        <div>
                            <p class="section-kicker">02 · LOCKERS</p>
                            <h2>Locker wall</h2>
                            <p>Application state lives in ParcelBox. The simulator only represents the external hardware controller.</p>
                        </div>
                        <span class="count-chip">@_compartments.Count compartments</span>
                    </div>

                    <div class="locker-cabinet">
                        @if (_compartments.Count == 0)
                        {
                            <div class="empty-state">
                                <span>□</span>
                                <strong>No compartment data</strong>
                                <p>Check the API connection and refresh the dashboard.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var compartment in _compartments)
                            {
                                <div class="locker-cell @GetCompartmentClass(compartment)">
                                    <div class="locker-door-top">
                                        <span class="locker-number">@compartment.Number</span>
                                        <span class="size-chip">@compartment.Size</span>
                                    </div>

                                    <div class="locker-door-center">
                                        <span class="locker-state-dot"></span>
                                        <strong>@compartment.Status</strong>
                                    </div>

                                    <div class="locker-door-bottom">
                                        <span>@compartment.LockerCode</span>
                                        @if (compartment.ParcelId.HasValue)
                                        {
                                            <span>Parcel assigned</span>
                                        }
                                        else
                                        {
                                            <span>Ready</span>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </article>

                <article class="surface timeline-surface">
                    <div class="section-heading-row compact-heading">
                        <div>
                            <p class="section-kicker">OBSERVABILITY</p>
                            <h2>Activity</h2>
                        </div>
                        <button class="button quiet small" type="button" @onclick="ClearActivity">Clear</button>
                    </div>

                    @if (_activity.Count == 0)
                    {
                        <div class="empty-state small-empty">
                            <span>◎</span>
                            <strong>Nothing happened yet</strong>
                            <p>Run one of the use-cases and watch the outcomes appear here.</p>
                        </div>
                    }
                    else
                    {
                        <ol class="activity-list">
                            @foreach (var item in _activity)
                            {
                                <li>
                                    <span class="activity-dot"></span>
                                    <span>@item</span>
                                </li>
                            }
                        </ol>
                    }
                </article>
            </div>
        </section>

        <section class="simulator-zone">
            <div class="simulator-zone-header">
                <div>
                    <p class="section-kicker">TEACHING / TEST HARNESS</p>
                    <h2>External system controls</h2>
                    <p>These switches are deliberately outside the ParcelBox business flow. Use them to demonstrate integration failures.</p>
                </div>
                <span class="boundary-chip">outside business domain</span>
            </div>

            <div class="simulator-grid">
                <article class="simulator-card">
                    <div class="simulator-title">
                        <div class="simulator-icon">LC</div>
                        <div>
                            <h3>Locker Controller</h3>
                            <p>Physical compartment hardware simulator</p>
                        </div>
                    </div>

                    <div class="current-mode">
                        <span>Current mode</span>
                        <strong>@(_lockerMode?.ToString() ?? "Offline")</strong>
                    </div>

                    <div class="segmented-control">
                        @foreach (var mode in Enum.GetValues<LockerMode>())
                        {
                            <button type="button"
                                    class="@GetLockerModeClass(mode)"
                                    @onclick="() => SetLockerModeAsync(mode)"
                                    disabled="@_busy">
                                @mode
                            </button>
                        }
                    </div>
                </article>

                <article class="simulator-card">
                    <div class="simulator-title">
                        <div class="simulator-icon">MG</div>
                        <div>
                            <h3>Message Gateway</h3>
                            <p>External delivery provider simulator</p>
                        </div>
                    </div>

                    <div class="current-mode">
                        <span>Current mode</span>
                        <strong>@(_messageMode?.ToString() ?? "Offline")</strong>
                    </div>

                    <div class="segmented-control">
                        @foreach (var mode in Enum.GetValues<MessageGatewayMode>())
                        {
                            <button type="button"
                                    class="@GetMessageModeClass(mode)"
                                    @onclick="() => SetMessageModeAsync(mode)"
                                    disabled="@_busy">
                                @mode
                            </button>
                        }
                    </div>
                </article>

                <article class="simulator-card inbox-card">
                    <div class="section-heading-row compact-heading">
                        <div>
                            <h3>Gateway inbox</h3>
                            <p>The pickup code is visible here only because this is a teaching simulator.</p>
                        </div>
                        <button class="button quiet small" type="button" @onclick="ClearMessagesAsync" disabled="@_busy">Clear</button>
                    </div>

                    @if (_messages.Count == 0)
                    {
                        <div class="inbox-empty">No delivered messages.</div>
                    }
                    else
                    {
                        <div class="message-list">
                            @foreach (var message in _messages.OrderByDescending(x => x.SentAt))
                            {
                                var pickupCode = ExtractPickupCode(message.Text);
                                <div class="message-card">
                                    <div class="message-meta">
                                        <strong>@message.Destination</strong>
                                        <span>@message.SentAt.ToLocalTime().ToString("HH:mm:ss")</span>
                                    </div>
                                    <p>@message.Text</p>
                                    @if (pickupCode is not null)
                                    {
                                        <button class="code-button" type="button" @onclick="() => UsePickupCode(pickupCode)">
                                            <span>@pickupCode</span>
                                            Use code
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </article>
            </div>
        </section>
    </main>

    @if (_busy)
    {
        <div class="busy-indicator" role="status">
            <span class="spinner"></span>
            Working…
        </div>
    }
</div>

@code {
    private string _trackingCode = "PKG-001";
    private string _recipientPhone = "+38160111222";
    private SizeCategory _size = SizeCategory.Medium;
    private string _pickupTrackingCode = "PKG-001";
    private string _pickupCode = string.Empty;
    private ParcelDetails? _currentParcel;
    private List<CompartmentDetails> _compartments = [];
    private List<SentMessage> _messages = [];
    private readonly List<string> _activity = [];
    private bool _apiOnline;
    private bool _lockerOnline;
    private bool _messageOnline;
    private LockerMode? _lockerMode;
    private MessageGatewayMode? _messageMode;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAllAsync();
    }

    private async Task RegisterAsync()
    {
        await RunBusyAsync(async () =>
        {
            var result = await Api.RegisterAsync(
                new RegisterParcelRequest(_trackingCode, _recipientPhone, _size));

            if (result.Value is null)
            {
                AddActivity($"Registration failed: {result.Error}");
                return;
            }

            _currentParcel = result.Value;
            _pickupTrackingCode = result.Value.TrackingCode;
            AddActivity($"Parcel {result.Value.TrackingCode} registered as {result.Value.Size}.");
        });
    }

    private async Task StoreAsync()
    {
        if (_currentParcel is null)
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            var result = await Api.StoreAsync(_currentParcel.Id);

            if (result.Value is null)
            {
                AddActivity($"Store failed: {result.Error}");
                await RefreshOperationalStateAsync();
                return;
            }

            AddActivity(
                $"Parcel stored in {result.Value.LockerCode}/{result.Value.CompartmentNumber}; message {result.Value.MessageDelivery}.");

            await RefreshCurrentParcelAsync();
            await RefreshOperationalStateAsync();
        });
    }

    private async Task PickupAsync()
    {
        await RunBusyAsync(async () =>
        {
            var error = await Api.PickupAsync(_pickupTrackingCode, _pickupCode);

            if (error is not null)
            {
                AddActivity($"Pickup failed: {error}");
                await RefreshOperationalStateAsync();
                return;
            }

            AddActivity($"Parcel {_pickupTrackingCode} picked up successfully.");
            await RefreshCurrentParcelAsync();
            await RefreshOperationalStateAsync();
        });
    }

    private async Task RefreshAllAsync()
    {
        await RunBusyAsync(async () =>
        {
            _apiOnline = await Api.IsHealthyAsync();
            _lockerOnline = await LockerSimulator.IsHealthyAsync();
            _messageOnline = await MessageGateway.IsHealthyAsync();

            await RefreshOperationalStateAsync();

            if (_currentParcel is not null)
            {
                await RefreshCurrentParcelAsync();
            }
        });
    }

    private async Task RefreshOperationalStateAsync()
    {
        var compartments = await Api.ListCompartmentsAsync();
        _compartments = compartments.Value?.ToList() ?? [];

        _lockerMode = await LockerSimulator.GetModeAsync();
        _messageMode = await MessageGateway.GetModeAsync();
        _messages = (await MessageGateway.ListMessagesAsync()).ToList();

        _apiOnline = await Api.IsHealthyAsync();
        _lockerOnline = await LockerSimulator.IsHealthyAsync();
        _messageOnline = await MessageGateway.IsHealthyAsync();
    }

    private async Task RefreshCurrentParcelAsync()
    {
        if (_currentParcel is null)
        {
            return;
        }

        var result = await Api.GetAsync(_currentParcel.Id);

        if (result.Value is not null)
        {
            _currentParcel = result.Value;
        }
    }

    private async Task SetLockerModeAsync(LockerMode mode)
    {
        await RunBusyAsync(async () =>
        {
            var changed = await LockerSimulator.SetModeAsync(mode);
            _lockerMode = await LockerSimulator.GetModeAsync();
            _lockerOnline = await LockerSimulator.IsHealthyAsync();

            AddActivity(changed
                ? $"Locker simulator switched to {mode}."
                : "Locker simulator mode change failed.");
        });
    }

    private async Task SetMessageModeAsync(MessageGatewayMode mode)
    {
        await RunBusyAsync(async () =>
        {
            var changed = await MessageGateway.SetModeAsync(mode);
            _messageMode = await MessageGateway.GetModeAsync();
            _messageOnline = await MessageGateway.IsHealthyAsync();

            AddActivity(changed
                ? $"Message simulator switched to {mode}."
                : "Message simulator mode change failed.");
        });
    }

    private async Task ClearMessagesAsync()
    {
        await RunBusyAsync(async () =>
        {
            var cleared = await MessageGateway.ClearMessagesAsync();
            _messages = (await MessageGateway.ListMessagesAsync()).ToList();
            AddActivity(cleared ? "Message simulator inbox cleared." : "Message simulator inbox could not be cleared.");
        });
    }

    private async Task RunBusyAsync(Func<Task> action)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;

        try
        {
            await action();
        }
        finally
        {
            _busy = false;
        }
    }

    private void AddActivity(string text)
    {
        _activity.Insert(0, $"{DateTimeOffset.Now:HH:mm:ss} · {text}");

        if (_activity.Count > 12)
        {
            _activity.RemoveAt(_activity.Count - 1);
        }
    }

    private void ClearActivity()
    {
        _activity.Clear();
    }

    private void UsePickupCode(string pickupCode)
    {
        _pickupCode = pickupCode;
        AddActivity($"Pickup code {pickupCode} copied from simulator inbox.");
    }

    private string GetLockerModeClass(LockerMode mode)
    {
        return _lockerMode == mode ? "segment active" : "segment";
    }

    private string GetMessageModeClass(MessageGatewayMode mode)
    {
        return _messageMode == mode ? "segment active" : "segment";
    }

    private static string GetServiceClass(bool online)
    {
        return online ? "online" : "offline";
    }

    private static string GetParcelStatusClass(ParcelStatus status)
    {
        return status switch
        {
            ParcelStatus.Registered => "neutral",
            ParcelStatus.Stored => "stored",
            ParcelStatus.PickedUp => "completed",
            _ => "neutral"
        };
    }

    private string GetCompartmentClass(CompartmentDetails compartment)
    {
        var statusClass = compartment.Status == CompartmentStatus.Available ? "available" : "occupied";
        var currentClass = _currentParcel?.CompartmentNumber == compartment.Number ? " current" : string.Empty;
        return statusClass + currentClass;
    }

    private static string? ExtractPickupCode(string text)
    {
        const string marker = "Pickup code: ";
        var index = text.LastIndexOf(marker, StringComparison.OrdinalIgnoreCase);

        if (index < 0)
        {
            return null;
        }

        var pickupCode = text[(index + marker.Length)..].Trim();
        return pickupCode.Length == 6 && pickupCode.All(char.IsDigit) ? pickupCode : null;
    }
}
