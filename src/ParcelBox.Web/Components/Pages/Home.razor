@page "/"

<PageTitle>ParcelBox</PageTitle>

<div class="page-shell">
    <DashboardHeader ApiOnline="_apiOnline"
                     LockerOnline="_lockerOnline"
                     MessageOnline="_messageOnline"
                     Busy="_busy"
                     RefreshRequested="RefreshDashboardAsync" />

    <main>
        <FlowOverview Status="_currentParcel?.Status" />

        <section class="workspace-grid">
            <div class="workflow-column">
                <ParcelRegistrationCard Form="_registerForm"
                                        CurrentParcel="_currentParcel"
                                        Busy="_busy"
                                        RegisterRequested="RegisterAsync"
                                        StoreRequested="StoreAsync" />

                <PickupCard Form="_pickupForm"
                            CurrentParcel="_currentParcel"
                            Busy="_busy"
                            PickupRequested="PickupAsync" />
            </div>

            <div class="visual-column">
                <LockerWall Compartments="_compartments"
                            CurrentParcel="_currentParcel" />

                <ActivityPanel Items="_activity"
                               ClearRequested="ClearActivity" />
            </div>
        </section>

        <SimulatorControls CurrentLockerMode="_lockerMode"
                           CurrentMessageMode="_messageMode"
                           Messages="_messages"
                           Busy="_busy"
                           LockerModeChanged="SetLockerModeAsync"
                           MessageModeChanged="SetMessageModeAsync"
                           ClearMessagesRequested="ClearMessagesAsync"
                           PickupCodeSelected="UsePickupCode" />
    </main>

    @if (_busy)
    {
        <div class="busy-indicator" role="status">
            <span class="spinner"></span>
            Working…
        </div>
    }
</div>
